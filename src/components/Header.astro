---
const links=[{href:"/about/",label:"About"},{href:"/projects/",label:"Projects"},{href:"/reports/",label:"Write-ups & Research"},{href:"/certifications/",label:"Certifications"},{href:"https://medium.com/@gabrielreissantos",label:"Blog"},{href:"/contact/",label:"Contact"}];
const pathname=Astro.url.pathname;
---
<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header"><div class="container"><nav class="nav-shell" aria-label="Main navigation">
<a class="brand" href="/" aria-label="GabrielsMind home"><span>gabriels<strong>mind</strong><span class="brand-dot">.</span></span></a>
<div class="nav-right"><div class="nav-links" id="site-menu">{links.map(link=><a href={link.href} aria-current={pathname.startsWith(link.href)?'page':undefined}>{link.label}</a>)}<a class="mobile-extra" href="/academy/">Cyber Academy ↗</a></div><a href="/academy/" class="nav-action">CYBER ACADEMY <span aria-hidden="true">↗</span></a></div>
<button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="Toggle navigation"><span></span><span></span><span></span></button>
</nav></div></header>
<script>
const toggle=document.querySelector('.nav-toggle');const menu=document.querySelector('#site-menu');if(toggle && menu){toggle.addEventListener('click',()=>{const open=menu.classList.toggle('is-open');toggle.setAttribute('aria-expanded',String(open))});menu.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{menu.classList.remove('is-open');toggle.setAttribute('aria-expanded','false')}));document.addEventListener('keydown',e=>{if(e.key==='Escape'){menu.classList.remove('is-open');toggle.setAttribute('aria-expanded','false')}})}
</script>
<style>
.skip-link{position:fixed;top:-100px;left:15px;z-index:1000;background:var(--accent);color:var(--bg);padding:10px}.skip-link:focus{top:10px}.site-header{position:sticky;top:0;z-index:100;background:#09111de8;border-top:2px solid #64e7bc;border-bottom:1px solid #223c4b;backdrop-filter:blur(17px)}.nav-shell{height:75px;display:flex;justify-content:space-between;align-items:center;gap:20px}.brand{display:flex;align-items:center;gap:0;font-size:18px;font-weight:500;letter-spacing:-.045em;white-space:nowrap}.brand strong{font-weight:850}.brand-dot{color:var(--accent)}.nav-right{display:flex;align-items:center;gap:24px}.nav-links{display:flex;align-items:center;gap:22px}.nav-links a{font-size:12px;font-weight:650;color:#b0c3cc;white-space:nowrap}.nav-links a:hover,.nav-links a[aria-current=page]{color:var(--accent)}.nav-action{font:750 11px ui-monospace,monospace;border:1px solid #428778;padding:11px 14px;color:#b9fce3;letter-spacing:.02em;white-space:nowrap}.nav-action:hover{background:#18463e}.nav-toggle,.mobile-extra{display:none}.nav-toggle{width:41px;height:41px;background:#132f3c;border:1px solid #355968;border-radius:5px;align-items:center;justify-content:center;flex-direction:column;gap:5px}.nav-toggle span{width:18px;height:2px;background:#d5f4ea}
@media(max-width:1150px){.nav-links{gap:12px}.nav-links a{font-size:11px}.nav-right{gap:14px}}@media(max-width:990px){.nav-shell{height:67px}.nav-toggle{display:flex}.nav-right{margin-left:auto}.nav-action{display:none}.nav-links{display:none;position:absolute;top:67px;left:0;right:0;flex-direction:column;align-items:stretch;padding:18px 24px 24px;background:#0a1a27;border-bottom:1px solid var(--border);box-shadow:0 18px 30px #0006}.nav-links.is-open{display:flex}.nav-links a{font-size:14px;padding:9px}.mobile-extra{display:block;color:var(--accent)!important}}
</style>

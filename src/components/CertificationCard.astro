---
interface Props{title:string;issuer:string;status?:string;year?:string;summary:string;skills?:string[];href?:string;credentialId?:string}
const {title,issuer,status='Completed',year,summary,skills=[],href,credentialId}=Astro.props;
const normalizedStatus=status.toLowerCase();const statusClass=normalizedStatus==='completed'?'completed':normalizedStatus==='in progress'?'in-progress':normalizedStatus==='planned'?'planned':'default';const hasCredentialLink=!!href&&href!=='#';
---
<article class={`cert-card ${statusClass}`}><div class="cert-top"><div><span class={`cert-status ${statusClass}`}>{status}</span><h3>{title}</h3><p class="issuer">{issuer}</p></div>{year&&<span class="cert-year">{year}</span>}</div><p class="summary">{summary}</p>{credentialId&&<p class="credential-id"><strong>Credential ID:</strong> {credentialId}</p>}{skills.length>0&&<div class="tag-row">{skills.map(skill=><span class="tag">{skill}</span>)}</div>}{hasCredentialLink?<a class="cert-link" href={href} target="_blank" rel="noopener noreferrer">View credential ↗</a>:<p class="cert-note">{status==='Completed'?'Credential link not provided.':'Learning roadmap.'}</p>}</article>
<style>.cert-card{min-height:100%;border:1px solid var(--border);border-radius:9px;padding:26px;background:linear-gradient(145deg,#152b3c,#0d1d2a);display:flex;flex-direction:column;gap:12px;transition:transform .2s,border-color .2s}.cert-card:hover{transform:translateY(-3px);border-color:#4e8c83}.cert-top{display:flex;justify-content:space-between;gap:10px}.cert-status{color:#7cdeba;background:#163d37;border:1px solid #285d4b;padding:6px 9px;font:800 10px ui-monospace,monospace;letter-spacing:.05em;text-transform:uppercase;border-radius:4px;display:inline-block;margin-bottom:18px}.cert-status.in-progress{background:#193646;border-color:#306d87;color:var(--cyan)}.cert-status.planned{background:#303324;border-color:#6c7148;color:#d7d89a}.cert-card h3{font-size:24px;margin:0 0 6px;line-height:1.14}.issuer{font:700 12px ui-monospace,monospace;color:var(--soft);margin:0}.cert-year{font:700 10px ui-monospace,monospace;color:var(--soft);white-space:nowrap}.summary{font-size:13px;line-height:1.75;margin:8px 0 0}.credential-id{font:600 11px ui-monospace,monospace;overflow-wrap:anywhere;margin:0}.cert-card .tag-row{margin:10px 0}.cert-link{color:var(--accent);font:800 11px ui-monospace,monospace;margin-top:auto}.cert-note{margin-top:auto;font:600 11px ui-monospace,monospace;color:#7998a7}.cert-link:hover{text-decoration:underline}</style>

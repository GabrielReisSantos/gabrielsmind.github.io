---
interface Props{eyebrow?:string;title?:string;text:string;primaryHref?:string;primaryLabel?:string;secondaryHref?:string;secondaryLabel?:string;imageSrc?:string;imageAlt?:string}
const {eyebrow,title='Offense by curiosity. Defense by design.',text,primaryHref,primaryLabel,secondaryHref,secondaryLabel,imageSrc,imageAlt='GabrielsMind photograph'}=Astro.props;
---
<section class="hero-shell"><div class="container hero-content"><div class="hero-copy"><p class="eyebrow">{eyebrow}</p><h1>{title}</h1><p class="lead">{text}</p><div class="button-row">{primaryHref&&primaryLabel&&<a class="button primary" href={primaryHref}>{primaryLabel} <span aria-hidden="true">↗</span></a>}{secondaryHref&&secondaryLabel&&<a class="button secondary" href={secondaryHref}>{secondaryLabel} <span aria-hidden="true">↗</span></a>}</div></div><div class="hero-media" aria-hidden="true">{imageSrc&&<img src={imageSrc} alt={imageAlt} loading="eager"/>}</div></div></section>
<style>.hero-shell{position:relative;padding:65px 0 0;border-bottom:1px solid var(--border);overflow:hidden;background:radial-gradient(circle at 82% 30%,#1b525036,transparent 46%)}.hero-content{display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:60px;min-height:450px;padding-bottom:70px}.hero-copy h1{font-size:clamp(3.2rem,5.9vw,6rem);max-width:900px;letter-spacing:-.07em;line-height:1.02;margin:0 0 25px}.hero-copy .lead{font-size:16px;line-height:1.9;max-width:580px}.hero-media{position:relative;height:370px;border:1px solid #335467;overflow:hidden;background:linear-gradient(140deg,#18384b,#10212e)}.hero-media img{height:100%;width:100%;object-fit:cover;opacity:.75;filter:grayscale(.16) saturate(.65) contrast(1.1)}.hero-media:after{content:'';position:absolute;inset:0;background:linear-gradient(0deg,#09111dc4,transparent 75%)}.media-marker{position:absolute;bottom:20px;left:21px;z-index:1;font:700 10px ui-monospace,monospace;letter-spacing:.13em;color:#d3eee8}.media-cross{position:absolute;top:10px;right:20px;z-index:1;color:var(--accent);font-size:30px}.hero-underscript{padding:20px 0;display:flex;justify-content:space-between;gap:20px;color:var(--soft);font:700 10px ui-monospace,monospace;letter-spacing:.11em}@media(max-width:900px){.hero-content{grid-template-columns:1fr;gap:28px;padding-bottom:44px}.hero-media{height:300px}.hero-copy h1{max-width:720px}}@media(max-width:640px){.hero-shell{padding-top:50px}.hero-copy h1{font-size:clamp(2.7rem,11vw,4.6rem)}.hero-underscript{font-size:9px;flex-direction:column;gap:5px}}</style>

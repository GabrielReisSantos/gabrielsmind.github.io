---
import BaseLayout from "../../layouts/BaseLayout.astro";
const completed = [
  { title: "Cisco Certified Network Associate (CCNA)", issuer: "Cisco", detail: "2026", href: "https://www.credly.com/badges/fabf850f-cc6f-4eb7-b2bd-101328e81314", linkLabel: "View credential" },
  { title: "CompTIA Security+", issuer: "CompTIA", href: "https://www.credly.com/badges/dd60fec9-86c5-4de2-b068-2cffd888d92a", linkLabel: "View credential" },
  { title: "Security Operations Professional", issuer: "Palo Alto Networks", href: "https://www.credly.com/badges/ec43a042-4822-4e93-82c6-6c4ec3919f97", linkLabel: "View credential" },
  { title: "Microsoft Certified: Security Operations Analyst Associate", issuer: "Microsoft", detail: "SC-200", href: "https://learn.microsoft.com/en-us/credentials/certifications/security-operations-analyst/", linkLabel: "About certification" },
  { title: "Fortinet Certified Associate in Cybersecurity", issuer: "Fortinet", detail: "2025 · ID 54213480186S" },
  { title: "Penetration Testing, Threat Hunting, and Cryptography", issuer: "IBM", href: "https://www.credly.com/badges/dc3f0610-689b-4715-b0bf-4469ce63ef29", linkLabel: "View credential" },
];
const achievements = [
  { title: "Zephyr", type: "Pro Lab", platform: "HTB Labs", date: "Mar 2026", status: "Verified" },
  { title: "Dante", type: "Pro Lab", platform: "HTB Labs", date: "Mar 2026", status: "Verified" },
];
const htbProfile = "https://profile.hackthebox.com/profile/019cbeff-c958-7184-b047-f0d25cc9dec8";
const development = [
  { title: "OSCP", issuer: "OffSec", status: "In progress" },
  { title: "GIAC GRID", issuer: "GIAC", status: "Planned" },
];
---
<BaseLayout title="Certifications | GabrielsMind" description="Gabriel Reis Santos — certifications in networking, security operations, cloud security and offensive security.">
  <div class="container credentials-page">
    <header class="credentials-heading"><p class="eyebrow">Gabriel Reis Santos</p><h1>Certifications<span class="mint">.</span></h1><p>Professional credentials and hands-on training.</p></header>
    <section aria-labelledby="completed-title" class="credentials-section">
      <div class="credentials-section-head"><h2 id="completed-title">Completed</h2><span>{completed.length} credentials</span></div>
      <div class="credentials-list">
        {completed.map(cert => <article class="credential-row"><div class="credential-main"><span class="credential-issuer">{cert.issuer}{cert.detail ? ` · ${cert.detail}` : ""}</span><h3>{cert.title}</h3></div>{cert.href ? <a class="credential-link" href={cert.href} target="_blank" rel="noopener noreferrer">{cert.linkLabel} <span aria-hidden="true">↗</span></a> : <span class="credential-unlinked">Completed</span>}</article>)}
      </div>
    </section>
    <section aria-labelledby="achievements-title" class="credentials-section achievements-section">
      <div class="credentials-section-head"><h2 id="achievements-title">Hack The Box achievements</h2><a class="credentials-profile" href={htbProfile} target="_blank" rel="noopener noreferrer">View HTB profile ↗</a></div>
      <div class="credentials-list">
        {achievements.map(item => <article class="credential-row"><div class="credential-main"><span class="credential-issuer">{item.platform} · {item.type}</span><h3>{item.title}</h3></div><div class="credential-achievement"><span>{item.date} · {item.status}</span><a class="credential-link" href={htbProfile} target="_blank" rel="noopener noreferrer">Profile ↗</a></div></article>)}
      </div>
    </section>
    <section aria-labelledby="development-title" class="credentials-section development-section">
      <div class="credentials-section-head"><h2 id="development-title">Training &amp; ongoing study</h2></div>
      <div class="credentials-list">
        {development.map(item => <article class="credential-row"><div class="credential-main"><span class="credential-issuer">{item.issuer}{item.extra ? ` · ${item.extra}` : ""}</span><h3>{item.title}</h3></div><span class="credential-unlinked">{item.status}</span></article>)}
      </div>
    </section>
  </div>
</BaseLayout>
<style>
.credentials-page{padding-top:105px;padding-bottom:130px;max-width:1050px}
.credentials-heading{margin-bottom:80px;max-width:720px}
.credentials-heading h1{font-size:clamp(3.3rem,7vw,6.2rem);margin:0 0 23px;letter-spacing:-.075em}
.credentials-heading>p:last-child{color:#b8cbd5;font-size:18px;line-height:1.6}
.credentials-section{margin-top:35px}
.credentials-section-head{display:flex;align-items:baseline;justify-content:space-between;gap:15px;margin-bottom:16px}
.credentials-section-head h2{font-size:23px;letter-spacing:-.045em;margin:0;font-weight:650}
.credentials-section-head>span{font-size:12px;color:#829ba8}
.credential-row{display:grid;grid-template-columns:1fr auto;gap:32px;align-items:center;padding:28px 0;border-bottom:1px solid #2c4350}
.credential-row:first-child{border-top:1px solid #2c4350}
.credential-issuer{font-size:12px;color:#8aa4b2;letter-spacing:.025em}
.credential-main h3{font-size:clamp(19px,2vw,25px);font-weight:600;line-height:1.3;letter-spacing:-.035em;color:#eef6f9;margin:7px 0 0}
.credential-link{color:var(--accent);font-size:13px;font-weight:650;white-space:nowrap;display:inline-flex;align-items:center;gap:14px;padding:8px 0;border-bottom:1px solid transparent;transition:border-color .2s}
.credential-link:hover{border-bottom-color:var(--accent)}
.credential-unlinked{font-size:12px;color:#9ab0bc;white-space:nowrap}
.development-section{margin-top:80px}.achievements-section{margin-top:85px}.credentials-profile{color:var(--accent);font-size:13px}.credential-achievement{display:flex;align-items:center;gap:25px}.credential-achievement>span{color:#a6bcc6;font-size:12px;white-space:nowrap}
@media(max-width:680px){.credentials-page{padding-top:65px;padding-bottom:80px}.credentials-heading{margin-bottom:55px}.credentials-heading>p:last-child{font-size:16px}.credential-row{grid-template-columns:1fr;gap:9px;padding:22px 0}.credential-link{width:fit-content}.development-section{margin-top:70px}.achievements-section{margin-top:65px}.credential-achievement{align-items:flex-start;gap:15px;flex-wrap:wrap}}
</style>

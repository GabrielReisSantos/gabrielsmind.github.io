---
import BaseLayout from "../layouts/BaseLayout.astro";
const links = [
  { name: "LinkedIn", note: "Professional conversations", href: "https://www.linkedin.com/in/gabrielreis1712" },
  { name: "GitHub", note: "Source code and projects", href: "https://github.com/GabrielReisSantos" },
  { name: "Medium", note: "Articles and notes", href: "https://medium.com/@gabrielreissantos" },
  { name: "Schedule a call", note: "Calendly", href: "https://calendly.com/agendagabrielreis/45min" },
];
---
<BaseLayout title="Contact | GabrielsMind" description="Contact Gabriel Reis Santos for cybersecurity projects, research, and collaboration.">
  <section class="container contact-minimal">
    <p class="eyebrow">Contact</p>
    <h1>Have something<br/><span class="mint">in mind?</span></h1>
    <p class="contact-lead">For a project, collaboration or a conversation about security, connect with me here.</p>
    <div class="contact-links">
      {links.map(link => <a href={link.href} target="_blank" rel="noopener noreferrer"><span><strong>{link.name}</strong><small>{link.note}</small></span><span aria-hidden="true">↗</span></a>)}
    </div>
  </section>
</BaseLayout>
<style>
.contact-minimal{max-width:1000px;padding-top:115px;padding-bottom:155px}
.contact-minimal h1{margin:0 0 28px;font-size:clamp(3.7rem,7.5vw,7.5rem);line-height:1;letter-spacing:-.075em}
.contact-lead{font-size:18px;color:#b5cbd5;max-width:540px;line-height:1.8;margin-bottom:55px}
.contact-links{border-top:1px solid var(--border)}
.contact-links a{padding:25px 0;display:flex;justify-content:space-between;gap:20px;border-bottom:1px solid var(--border);align-items:center;color:var(--text)}
.contact-links a strong{display:block;font-size:22px;font-weight:650;letter-spacing:-.04em}
.contact-links a small{display:block;color:var(--soft);font-size:13px;margin-top:3px}
.contact-links a>span:last-child{font-size:22px;color:var(--accent);transition:transform .2s}
.contact-links a:hover>span:last-child{transform:translate(3px,-3px)}
@media(max-width:700px){.contact-minimal{padding-top:70px;padding-bottom:90px}.contact-lead{font-size:16px}}
</style>

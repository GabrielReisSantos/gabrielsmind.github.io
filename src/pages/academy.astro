---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
const modules=[
 {title:"Foundations",text:"Build confidence with networking, TCP/IP, routing, segmentation, zero trust, TLS, certificates and introductory coding concepts.",tags:["CCNA","Networking","TLS & PKI","Python"],label:"01 / Learn"},
 {title:"Network & Firewall Lab",text:"Explore simulated packet flows, VLANs, routes, App-ID concepts, firewall rules, stateful sessions, NAT and policy troubleshooting.",tags:["NGFW","Packet Studio","NAT","Network 3D"],label:"02 / Simulate"},
 {title:"Investigate & Defend",text:"Start with an attacker action, inspect synthetic telemetry and evidence, determine its impact, deploy controls and retest the outcome.",tags:["SOC","Purple Team","Active Directory","Incident Response"],label:"03 / Investigate"},
 {title:"Pentest Academy",text:"Practice authorized methodology, enumeration, evidence collection and report writing in controlled educational scenarios.",tags:["Pentest","OSCP path","Reporting"],label:"04 / Assess"}
];
---
<BaseLayout title="Cyber Academy | GabrielsMind" description="GabrielsMind Cyber Academy — learn, break, investigate and defend in browser-based synthetic cybersecurity simulations.">
<section class="academy-hero"><div class="container"><p class="eyebrow">GabrielsMind / Learning & Simulations</p><div class="academy-head"><div><h1>Learn the system.<br/><span>Challenge the system.</span><br/>Defend the system.</h1><p class="lead">A hands-on academy built around one principle: cybersecurity becomes clear when you can see the consequences of every decision.</p><div class="button-row"><a class="button primary" href="#learning-paths">Explore learning paths ↓</a><a class="button secondary" href="/projects/">See all projects ↗</a></div><p class="microcopy" style="margin-top:23px">Cyber Academy is a separate browser-based training project. Its interactive release will live at /training/ when deployed.</p></div><div class="academy-graphic" aria-hidden="true"><div class="diagram-grid"></div><div class="big-core">C/A</div><div class="orbit orbit-a"></div><div class="orbit orbit-b"></div><div class="orbit orbit-c"></div><span class="grid-label">SECURITY SYSTEMS / INTEGRATED PRACTICE</span></div></div></div></section>
<section class="section container"><div class="section-head"><div><p class="eyebrow">The learning loop</p><h2 class="section-title">Four steps. Real understanding.</h2></div><p class="lead">Not just questions to memorize: experiments that show what changed, why it happened and whether a defensive fix actually worked.</p></div><div class="flow-list"><div><span>01</span><strong>Explore</strong><p>Understand the components, paths and rules.</p></div><div><span>02</span><strong>Break</strong><p>Make a controlled mistake and observe the effect.</p></div><div><span>03</span><strong>Investigate</strong><p>Collect evidence and establish the root cause.</p></div><div><span>04</span><strong>Fix</strong><p>Apply a correction and validate against regressions.</p></div></div></section>
<section id="learning-paths" class="section container"><div class="section-head"><div><p class="eyebrow">What you can study</p><h2 class="section-title">Connected learning paths.</h2></div><p class="lead">Modules are developed incrementally. Content and behaviors in the live demonstration may differ from this roadmap.</p></div><div class="grid grid-2">{modules.map(module=><ProjectCard {...module}/>)}</div></section>
<section class="section container"><div class="research-panel"><p class="eyebrow">Implementation notes</p><h2>Browser-first by design.</h2><p>Interactive, deterministic learning scenarios run in the browser. The simulation is not a production firewall, an Active Directory instance or a live exploitation environment. The advanced Cyber Academy build is intended for <code>/training/</code> once it has been independently tested and deployed.</p><a href="/cyberlab/" class="button secondary">View my separate Proxmox homelab ↗</a></div></section>
</BaseLayout>
<style>.academy-hero{padding:90px 0;border-bottom:1px solid var(--border);background:radial-gradient(circle at 76% 30%,#154d4d66,transparent 45%)}.academy-head{display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:55px}.academy-head h1{font-size:clamp(3.2rem,5.7vw,6rem);letter-spacing:-.07em;line-height:1.02}.academy-head h1 span{color:var(--accent)}.academy-graphic{position:relative;height:420px;overflow:hidden;border:1px solid var(--border);display:grid;place-items:center;background:#0d2331}.diagram-grid{position:absolute;inset:0;background-image:linear-gradient(#22526544 1px,transparent 1px),linear-gradient(90deg,#22526544 1px,transparent 1px);background-size:26px 26px}.big-core{font-size:50px;font-weight:900;color:var(--accent);z-index:2;padding:24px;letter-spacing:-.1em;border:1px solid #64e7bc88;background:#0b292c;box-shadow:0 0 45px #64e7bc3b}.orbit{position:absolute;border:1px solid #477b82;border-radius:50%;width:300px;height:160px;transform:rotate(24deg)}.orbit-b{transform:rotate(-40deg)}.orbit-c{transform:rotate(82deg)}.grid-label{position:absolute;bottom:17px;color:var(--soft);font:700 10px ui-monospace,monospace}.flow-list{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--border);background:#112635}.flow-list>div{padding:22px;border-right:1px solid var(--border)}.flow-list>div:last-child{border:0}.flow-list span{display:block;color:var(--accent);font:800 11px ui-monospace,monospace;margin-bottom:20px}.flow-list strong{font-size:22px}.flow-list p{font-size:13px;line-height:1.7;margin:10px 0 0}@media(max-width:900px){.academy-head{grid-template-columns:1fr}.academy-graphic{height:280px}.flow-list{grid-template-columns:repeat(2,1fr)}.flow-list>div:nth-child(2){border:0}.flow-list>div:nth-child(-n+2){border-bottom:1px solid var(--border)}}@media(max-width:550px){.flow-list{grid-template-columns:1fr}.flow-list>div{border-right:0!important;border-bottom:1px solid var(--border)!important}.flow-list>div:last-child{border-bottom:0!important}.academy-hero{padding:50px 0}}
</style>

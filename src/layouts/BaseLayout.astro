---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
const { title = "GabrielsMind",description = "Offense by curiosity. Defense by design. Cybersecurity portfolio, projects and research." } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><meta name="theme-color" content="#09111d"/><meta name="description" content={description}/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><title>{title}</title></head><body><Header/><main id="main-content" class={Astro.url.pathname === "/" ? "homepage-main" : "interior-main"}><slot/></main><Footer/></body></html>
